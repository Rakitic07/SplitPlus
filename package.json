{
  "name": "split-plus",
  "version": "1.0.0",
  "private": true,
  "description": "Split-Plus — a glassy, interactive Splitwise-style group expense splitter. React (Vite) SPA + Express API, deployable to Vercel.",
  "type": "module",
  "scripts": {
    "predev": "prisma generate --schema prisma/schema.sqlite.prisma",
    "dev": "concurrently -k -n web,api -c magenta,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "db:push": "prisma db push",
    "db:push:local": "prisma db push --schema prisma/schema.sqlite.prisma",
    "postinstall": "prisma generate --schema prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/d3-force": "^3.0.10",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "d3-force": "^3.0.0",
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "jose": "^5.10.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  }
}
